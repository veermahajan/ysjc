---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" current="" description="Get in touch with the YSJC team. Email ysjcteam@gmail.com — we typically respond within 48 hours.">

  <header class="page-header">
    <div class="container narrow">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch.</h1>
    </div>
  </header>

  <section class="section">
    <div class="container narrow contact-grid">
      <div class="contact-card">
        <p class="eyebrow">Email</p>
        <p class="big-email"><a href="mailto:ysjcteam@gmail.com">ysjcteam@gmail.com</a></p>
        <p class="muted">We typically respond within 48 hours.</p>
      </div>

      <div class="contact-card">
        <p class="eyebrow">Parent meeting</p>
        <p class="big-text">Weekend of June 13–14, 2026</p>
        <p class="muted">The Zoom link is sent to registered families before the meeting. <a href="/register">Sign up for updates</a> if you'd like to receive it.</p>
      </div>

      <div class="contact-card">
        <p class="eyebrow">Common questions</p>
        <p>Most parent questions are answered on the program page:</p>
        <p><a class="btn btn-ghost btn-arrow" href="/program#faq">Read the FAQ</a></p>
      </div>

      <div class="contact-card">
        <p class="eyebrow">Want to mentor?</p>
        <p>If you're a high school student with research or teaching experience in a STEM field, we'd love to hear from you.</p>
        <p><a class="btn btn-ghost btn-arrow" href="mailto:ysjcteam@gmail.com?subject=Mentoring%20for%20Summer%202026">Email us about mentoring</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: var(--ysjc-mint);
    padding-block: clamp(48px, 8vw, 96px) clamp(32px, 5vw, 48px);
  }
  .narrow { max-width: 880px; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: var(--space-4);
  }

  .big-email a {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--ysjc-blue);
    word-break: break-all;
  }
  .big-text {
    font-family: var(--font-display);
    font-size: var(--fs-h-l);
    color: var(--ysjc-blue);
  }
</style>
