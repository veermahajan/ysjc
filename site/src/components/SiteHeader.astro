---
import { Image } from 'astro:assets';
import wordmark from '../assets/logo/wordmark.png';

const { current } = Astro.props as { current?: string };

const nav = [
  { href: '/program',  label: 'Program'  },
  { href: '/subjects', label: 'Subjects' },
  { href: '/mentors',  label: 'Mentors'  },
  { href: '/journal',  label: 'Journal'  },
  { href: '/register', label: 'Register' },
];
---

<header class="site-header">
  <div class="container header-row">
    <a href="/" class="brand" aria-label="Youth STEM Journal Club — home">
      <Image src={wordmark} alt="Youth STEM Journal Club" widths={[200, 400]} sizes="200px" />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', current === item.href.replace('/', '') ? 'is-current' : '']}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="nav-toggle" aria-label="Open menu" aria-controls="mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <nav aria-label="Mobile">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} class="mobile-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms, box-shadow 200ms;
  }
  .site-header.scrolled {
    border-bottom-color: var(--border);
    box-shadow: 0 1px 0 var(--border);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }
  .brand img {
    height: 32px;
    width: auto;
  }
  .site-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-3);
  }
  .nav-link {
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    font-size: var(--fs-small);
    padding: 6px 4px;
    border-bottom: 2px solid transparent;
    transition: color 150ms, border-color 150ms;
  }
  .nav-link:hover { color: var(--ysjc-blue); }
  .nav-link.is-current {
    color: var(--ysjc-blue);
    border-bottom-color: var(--ysjc-teal);
  }
  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 8px;
    flex-direction: column;
    gap: 5px;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }
  .mobile-drawer { display: none; }
  .mobile-drawer ul {
    list-style: none;
    margin: 0;
    padding: var(--space-2) var(--space-3) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .mobile-link {
    display: block;
    padding: 12px 4px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .site-nav { display: none; }
    .nav-toggle { display: flex; }
    .mobile-drawer { display: block; }
    .mobile-drawer[hidden] { display: none; }
  }
</style>

<script>
  // Sticky header shadow on scroll
  const header = document.querySelector('.site-header');
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 4) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Mobile drawer toggle
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const drawer = document.getElementById('mobile-drawer');
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const open = !drawer.hasAttribute('hidden');
      if (open) {
        drawer.setAttribute('hidden', '');
        toggle.setAttribute('aria-label', 'Open menu');
      } else {
        drawer.removeAttribute('hidden');
        toggle.setAttribute('aria-label', 'Close menu');
      }
    });
  }
</script>
